# Project
PROJECT_NAME=smart-ai-network-monitor
ENVIRONMENT=dev

# Prometheus
PROMETHEUS_BASE_URL=http://localhost:9090
PROMETHEUS_LATENCY_METRIC=network_latency_ms
PROMETHEUS_LOSS_METRIC=network_packet_loss_pct
PROMETHEUS_RETENTION=15d

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme
GRAFANA_ANON_ENABLED=false

# Telemetry simulator exporter
SIMULATOR_EXPORTER_HOST=0.0.0.0
SIMULATOR_EXPORTER_PORT=9108
SIMULATOR_SCRAPE_PATH=/metrics
SIMULATOR_DEVICE_ID=r2

# API
API_HOST=0.0.0.0
API_PORT=8000
ALERT_LOOKBACK_MINUTES=5
LATENCY_ALERT_THRESHOLD_MS=120
LOSS_ALERT_THRESHOLD_PCT=2.5
REMEDIATE_API_TOKEN=

# Ansible safety defaults
ANSIBLE_INVENTORY=ansible/inventory/hosts.yml
ANSIBLE_PLAYBOOK=ansible/playbooks/remediate_latency.yml
ANSIBLE_REMOTE_USER=admin
ANSIBLE_SSH_PRIVATE_KEY=~/.ssh/id_rsa
DRY_RUN_DEFAULT=true
CANARY_DEFAULT=true
ROLLBACK_DEFAULT=false